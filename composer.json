{
  "name": "prosvirin/laravel-env-sync",
  "description": "Sync .env.example with .env file in Laravel",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Yauheni Prasviryn",
      "email": "php.prosvirin.dev@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0",
    "illuminate/console": "^10.0|^11.0",
    "illuminate/filesystem": "^10.0|^11.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0",
    "pestphp/pest": "^2.0",
    "laravel/pint": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Prosvirin\\EnvSync\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Prosvirin\\EnvSync\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Prosvirin\\EnvSync\\EnvSyncServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "pest",
    "test:coverage": "pest --coverage",
    "format": "pint"
  }
}